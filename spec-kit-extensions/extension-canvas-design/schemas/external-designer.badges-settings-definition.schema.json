{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "types"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "rule", "defaultText", "defaultColor", "enabled"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000},
          "rule": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
          "replacementGroup": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
          "defaultText": {"type": "string", "minLength": 1, "maxLength": 120},
          "defaultColor": {"type": "string", "pattern": "^(?:theme|red|green|amber|blue|purple|pink|orange|#[0-9a-fA-F]{6})$"},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}

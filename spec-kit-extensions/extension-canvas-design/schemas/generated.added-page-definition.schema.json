{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "renderer"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$", "not": {"const": "workflow"}},
    "title": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
    "renderer": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
    "values": {"type": "array", "maxItems": 100, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"}},
    "slots": {"type": "array", "maxItems": 30, "items": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$"}
      }
    }}
  }
}

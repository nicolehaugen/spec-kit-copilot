{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "adapter", "inputTypes"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$"},
    "adapter": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
    "inputTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["artifact", "artifact-set", "ordered-artifacts", "phase", "text"]}
    }
  }
}

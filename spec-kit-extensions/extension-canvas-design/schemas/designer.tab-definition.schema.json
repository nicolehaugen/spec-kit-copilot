{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "order", "fields"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 1000},
    "order": {"type": "integer", "minimum": -100000, "maximum": 100000},
    "enabled": {"type": "boolean"},
    "slots": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$"}
        }
      }
    },
    "fields": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "dependentSchemas": {
          "default": {
            "required": ["type"],
            "properties": {"type": {"const": "boolean"}}
          }
        },
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 120},
          "control": {"enum": ["stock.text", "stock.checkbox"]},
          "description": {"type": "string", "maxLength": 1000},
          "type": {"enum": ["string", "boolean"]},
          "required": {"const": true},
          "default": {"type": "boolean"}
        },
        "if": {"required": ["required"]},
        "then": {"properties": {"type": {"const": "string"}}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "adapter", "badgeDestinations", "title", "order", "slots"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 2},
    "id": {"const": "workflow"},
    "adapter": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
    "badgeDestinations": {"type": "array", "uniqueItems": true, "maxItems": 4,
      "items": {"enum": ["workflow.list", "workflow.summary", "phase.card", "phase.output"]}},
    "title": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
    "order": {"const": 0},
    "slots": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true,
      "prefixItems": [{"type": "object", "additionalProperties": false,
        "required": ["id"], "properties": {"id": {"const": "workflow.phases"}}}],
      "items": {"type": "object", "additionalProperties": false,
        "required": ["id"],
        "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$"}}}}
  }
}

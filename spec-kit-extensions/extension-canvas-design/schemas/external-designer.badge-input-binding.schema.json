{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "rule", "control"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
    "rule": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
    "control": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$"}
  }
}

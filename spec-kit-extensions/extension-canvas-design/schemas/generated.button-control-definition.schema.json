{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "adapter"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {"enum": ["project.setup-button", "dialog.trigger"]},
    "adapter": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "page", "slot", "control"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {"const": "generated-phase-placement"},
    "page": {"const": "workflow"},
    "slot": {"const": "workflow.phases"},
    "control": {"const": "generated-phase-control"}
  }
}

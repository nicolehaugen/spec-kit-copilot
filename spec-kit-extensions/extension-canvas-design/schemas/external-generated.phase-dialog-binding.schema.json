{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "phase", "dialog"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
    "phase": {"type": "string", "pattern": "^speckit\\.[a-z][a-z0-9.-]{0,79}$",
      "not": {"const": "speckit.constitution"}},
    "dialog": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"}
  }
}

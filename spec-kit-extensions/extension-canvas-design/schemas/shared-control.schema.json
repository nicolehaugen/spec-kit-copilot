{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "value", "adapters"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^(?:[a-z][a-z0-9-]{0,79}|stock\\.(?:image|text|checkbox))$"},
    "value": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["type"],
        "properties": {"type": {"const": "string"}}},
      {"type": "object", "additionalProperties": false, "required": ["type"],
        "properties": {"type": {"const": "boolean"}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "maxBytes", "mimeTypes"],
        "properties": {"type": {"const": "image"}, "maxBytes": {"const": 32768},
          "mimeTypes": {"const": ["image/png", "image/jpeg", "image/gif", "image/webp"]}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "properties"],
        "properties": {"type": {"const": "object"},
          "properties": {"$ref": "#/$defs/properties"}}}
    ]},
    "adapters": {"type": "object", "additionalProperties": false,
      "required": ["designer"],
      "properties": {
        "designer": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
        "generated": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"}
      }}
  },
  "allOf": [
    {"if": {"properties": {"value": {"properties": {"type": {"const": "image"}}}}},
      "then": {"properties": {"id": {"const": "stock.image"}}}},
    {"if": {"properties": {"value": {"properties": {"type": {"const": "string"}}}}},
      "then": {"properties": {"id": {"const": "stock.text"}}}},
    {"if": {"properties": {"value": {"properties": {"type": {"const": "boolean"}}}}},
      "then": {"properties": {"id": {"const": "stock.checkbox"},
        "adapters": {"not": {"required": ["generated"]}}}}},
    {"if": {"properties": {"value": {"properties": {"type": {"const": "object"}}}}},
      "then": {"properties": {"id": {"pattern": "^[a-z][a-z0-9-]{0,79}$"}}}},
    {"if": {"properties": {"value": {"properties": {"type": {"enum": ["image", "string", "object"]}}}}},
      "then": {"properties": {"adapters": {"required": ["designer", "generated"]}}}}
  ],
  "$defs": {
    "properties": {"type": "object", "minProperties": 1, "maxProperties": 10,
      "patternProperties": {"^[a-z][A-Za-z0-9]{0,39}$": {
        "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
        "items": {"type": "string", "minLength": 1, "maxLength": 80}}},
      "additionalProperties": false}
  }
}

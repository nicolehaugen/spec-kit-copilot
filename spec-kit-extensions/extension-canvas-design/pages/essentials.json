{
  "$schema": "../schemas/designer.default-tab-definition.schema.json",
  "schemaVersion": 1,
  "id": "canvas-settings-setup",
  "title": "Essentials",
  "description": "Configure your canvas.",
  "order": 10,
  "enabled": true,
  "slots": [{"id": "essentials.options", "accepts": ["field"],
    "orderBy": ["order", "presetId", "id"]}],
  "fields": [
    {"id": "canvas.id", "label": "Canvas ID", "control": "stock.text", "description": "Use 1–100 characters: lowercase letters (a–z), numbers (0–9), and hyphens (-). Start with a letter or number. Reserved IDs cannot be used."},
    {"id": "canvas.displayName", "label": "Title", "control": "stock.text"}
  ]
}
